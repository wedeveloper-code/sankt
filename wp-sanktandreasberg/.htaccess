# WordPress .htaccess for sant-andreasberg.com
# Includes 301 redirects, performance optimizations, and WordPress rewrites.

Options -Indexes

# ============================================================
# Security headers
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================================
# Compression (mod_deflate)
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE image/svg+xml application/xml text/xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ============================================================
# Browser caching (mod_expires)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg          "access plus 1 year"
    ExpiresByType image/png           "access plus 1 year"
    ExpiresByType image/gif           "access plus 1 year"
    ExpiresByType image/webp          "access plus 1 year"
    ExpiresByType image/svg+xml       "access plus 1 year"
    ExpiresByType image/x-icon        "access plus 1 year"
    ExpiresByType font/woff2          "access plus 1 year"
    ExpiresByType font/woff           "access plus 1 year"
    ExpiresByType text/css            "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

# ============================================================
# 301 Redirects: old site → new WordPress URLs
# ============================================================
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Homepage / Index
RewriteRule ^bergsport/de/frames/index\.html$ / [R=301,L]
RewriteRule ^bergsport/de/text/index\.html$ / [R=301,L]
RewriteRule ^andreasberg/de/frames/index\.html$ / [R=301,L]

# Geschichte
RewriteRule ^bergsport/de/frames/geschichte\.html$ /geschichte/ [R=301,L]
RewriteRule ^bergsport/de/text/geschichte\.html$ /geschichte/ [R=301,L]
RewriteRule ^bergsport/de/text/info\.html$ /geschichte/ [R=301,L]

# Erleben / Aktiv
RewriteRule ^bergsport/de/frames/aktiv\.html$ /erleben/ [R=301,L]
RewriteRule ^bergsport/de/text/aktiv\.html$ /erleben/ [R=301,L]

# Wandertouren
RewriteRule ^bergsport/de/text/wandertouren\.html$ /routen/ [R=301,L]
RewriteRule ^bergsport/de/text/freibiersquelle\.html$ /routen/freibiersquelle/ [R=301,L]
RewriteRule ^bergsport/de/text/galgenberg\.html$ /routen/galgenberg/ [R=301,L]
RewriteRule ^bergsport/de/text/hoehenweg\.html$ /routen/hoehenwanderweg/ [R=301,L]
RewriteRule ^bergsport/de/text/rehbergrunde\.html$ /routen/rehberg-runde/ [R=301,L]
RewriteRule ^bergsport/de/text/sieberberg\.html$ /routen/sieberberg/ [R=301,L]
RewriteRule ^bergsport/de/text/silberteich\.html$ /routen/silberteich/ [R=301,L]
RewriteRule ^bergsport/de/text/skikreuz\.html$ /routen/skikreuz-wanderung/ [R=301,L]
RewriteRule ^bergsport/de/text/skikreuz-runde\.html$ /routen/skikreuz-runde/ [R=301,L]
RewriteRule ^bergsport/de/text/sonnenberg\.html$ /routen/sonnenberg-wanderung/ [R=301,L]
RewriteRule ^bergsport/de/text/wolfswarte\.html$ /routen/wolfswarte/ [R=301,L]
RewriteRule ^bergsport/de/text/bismark\.html$ /routen/bismarckturm-wanderung/ [R=301,L]
RewriteRule ^bergsport/de/text/flutgraben\.html$ /routen/clausthaler-flutgraben/ [R=301,L]
RewriteRule ^bergsport/de/text/achtermann-wandern\.html$ /routen/achtermann-wanderung/ [R=301,L]
RewriteRule ^bergsport/de/text/oderberg-runde\.html$ /routen/oderberg-runde-wandern/ [R=301,L]
RewriteRule ^bergsport/de/text/rinderstall\.html$ /routen/rinderstall-wanderung/ [R=301,L]

# MTB-Touren
RewriteRule ^bergsport/de/text/biketouren\.html$ /routen/ [R=301,L]
RewriteRule ^bergsport/de/text/drei-tuerme\.html$ /routen/drei-tuerme-tour/ [R=301,L]
RewriteRule ^bergsport/de/text/sonnenrunde\.html$ /routen/sonnenberg-runde-mtb/ [R=301,L]
RewriteRule ^bergsport/de/text/einhornrunde\.html$ /routen/einhornhoehle-runde/ [R=301,L]
RewriteRule ^bergsport/de/text/brockenritt\.html$ /routen/brockenritt/ [R=301,L]
RewriteRule ^bergsport/de/text/sperrlutter\.html$ /routen/sperrlutter-runde/ [R=301,L]
RewriteRule ^bergsport/de/text/odertalsperre\.html$ /routen/odertalsperren-runde/ [R=301,L]
RewriteRule ^bergsport/de/text/odertal-runde\.html$ /routen/odertal-runde/ [R=301,L]
RewriteRule ^bergsport/de/text/hanskuehn-runde\.html$ /routen/hanskuehn-burg-runde/ [R=301,L]

# Nordic Walking
RewriteRule ^bergsport/de/text/walkingtouren\.html$ /routen/ [R=301,L]
RewriteRule ^bergsport/de/text/hoehenwalk\.html$ /routen/hoehenweg-nordic/ [R=301,L]
RewriteRule ^bergsport/de/text/inliner-sieber\.html$ /routen/inliner-sieber-nordic/ [R=301,L]

# Loipen
RewriteRule ^bergsport/de/text/loipen\.html$ /routen/ [R=301,L]
RewriteRule ^bergsport/de/text/beerberg\.html$ /routen/beerberg-loipe/ [R=301,L]
RewriteRule ^bergsport/de/text/jordans\.html$ /routen/jordanshoehe-loipe/ [R=301,L]
RewriteRule ^bergsport/de/text/oderberg\.html$ /routen/oderberg-loipe/ [R=301,L]
RewriteRule ^bergsport/de/text/schneewittchenloipe\.html$ /routen/schneewittchen-loipe/ [R=301,L]
RewriteRule ^bergsport/de/text/sonnenberg-loipe\.html$ /routen/sonnenberg-loipe/ [R=301,L]
RewriteRule ^bergsport/de/text/achtermann\.html$ /routen/achtermann-loipe/ [R=301,L]

# Winterwandern
RewriteRule ^bergsport/de/text/winter-wandern\.html$ /routen/ [R=301,L]
RewriteRule ^bergsport/de/text/msb-winter\.html$ /routen/msb-winter/ [R=301,L]
RewriteRule ^bergsport/de/text/winter-sieberberg\.html$ /routen/sieberberg-winter/ [R=301,L]
RewriteRule ^bergsport/de/text/sonnenberg-winter\.html$ /routen/sonnenberg-winter/ [R=301,L]

# Sehenswürdigkeiten
RewriteRule ^bergsport/de/text/sehenswertes\.html$ /sehenswuerdigkeiten/ [R=301,L]
RewriteRule ^andreasberg/de/text/bergbau\.html$ /sehenswuerdigkeiten/grube-samson/ [R=301,L]

# Winter & Sommer
RewriteRule ^bergsport/de/frames/winter\.html$ /winter-sommer/ [R=301,L]
RewriteRule ^bergsport/de/text/winter\.html$ /winter-sommer/ [R=301,L]
RewriteRule ^bergsport/de/frames/sommer\.html$ /winter-sommer/ [R=301,L]
RewriteRule ^bergsport/de/text/sommer\.html$ /winter-sommer/ [R=301,L]
RewriteRule ^bergsport/de/text/pisten\.html$ /winter-sommer/ [R=301,L]
RewriteRule ^bergsport/de/text/rodeln\.html$ /winter-sommer/ [R=301,L]

# Unterkunft / A-Z Verzeichnis
RewriteRule ^bergsport/de/text/a-z\.html$ /unterkunft-gastronomie/ [R=301,L]

# Kontakt
RewriteRule ^bergsport/de/frames/kontakt\.html$ /kontakt/ [R=301,L]
RewriteRule ^bergsport/de/text/kontakt\.html$ /kontakt/ [R=301,L]

# Impressum / Datenschutz
RewriteRule ^bergsport/de/text/impressum\.html$ /impressum/ [R=301,L]
RewriteRule ^bergsport/de/text/datenschutz\.html$ /datenschutz/ [R=301,L]

# Veranstaltungen
RewriteRule ^bergsport/de/text/walpurgis\.html$ /veranstaltungen/ [R=301,L]

# Catch-all for remaining old pages
RewriteRule ^bergsport/de/(.+)$ / [R=301,L]
RewriteRule ^andreasberg/de/(.+)$ / [R=301,L]

# ============================================================
# WordPress standard rewrites (BEGIN WordPress)
# ============================================================

# BEGIN WordPress
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
# END WordPress

</IfModule>
